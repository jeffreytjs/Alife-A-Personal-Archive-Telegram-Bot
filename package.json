{
  "name": "alife-a-personal-archive-telegram-bot",
  "version": "2.1.0",
  "description": "Alife - A Personal Archive: daily Telegram word prompts for photo/video habits",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "update-urls": "node scripts/update-ngrok-urls.js",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:web": "cd web-interface && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\" --names \"BOT,WEB\" --prefix-colors \"cyan,magenta\"",
    "dev:full": "./scripts/dev-start.sh",
    "build:bot": "tsc",
    "build": "npm run build:bot && cd web-interface && npm run build",
    "start": "node dist/index.js",
    "test": "npm run lint && npm run validate:prompts && npm run test:unit",
    "test:unit": "tsx --test src/**/*.test.ts",
    "validate:prompts": "tsx scripts/validate-prompts.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist web-interface/.next"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.8",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.67.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.48"
  }
}
