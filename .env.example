# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public HTTPS URL of the bot server (Render in production, ngrok port 3000 locally)
TELEGRAM_WEBHOOK_URL=https://your-bot-server.example.com

# Optional display name used in /about and API responses
BOT_DISPLAY_NAME=Alife - A Personal Archive

# Prompt configuration (repo-relative path)
PROMPTS_CONFIG_PATH=config/prompts/prompts.yaml

# Local only: POST /internal/jobs/daily-prompt to trigger the 8am broadcast manually
ENABLE_DEV_JOB_ENDPOINT=false

# Telegram Mini App (Next.js on Vercel)
WEB_APP_ENABLED=false
WEB_APP_URL=https://your-mini-app.vercel.app

# Application
NODE_ENV=development
PORT=3000
MAX_CONVERSATION_HISTORY=20
RATE_LIMIT_MESSAGES_PER_MINUTE=10
LOG_LEVEL=info
